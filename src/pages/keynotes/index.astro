---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/primitives/Container.astro";
import { Image } from "astro:assets";

import speaker1 from "/src/assets/panel/speaker1.svg";
import speaker2 from "/src/assets/panel/speaker2.svg";
import speaker3 from "/src/assets/panel/speaker3.svg";
import speaker4 from "/src/assets/panel/speaker4.svg";
import speaker5 from "/src/assets/panel/speaker5.svg";
import speaker6 from "/src/assets/panel/speaker6.svg";
import speaker7 from "/src/assets/panel/speaker7.svg";
import speaker8 from "/src/assets/panel/speaker8.svg";
import speaker9 from "/src/assets/panel/speaker9.svg";
import speaker10 from "/src/assets/panel/speaker10.svg";
import speaker11 from "/src/assets/panel/speaker11.svg";
import speaker12 from "/src/assets/panel/speaker12.svg";
import speaker13 from "/src/assets/panel/speaker13.svg";
import speaker14 from "/src/assets/panel/speaker14.svg";
import speaker15 from "/src/assets/panel/speaker15.svg";
import speaker16 from "/src/assets/panel/speaker16.svg";
import speaker17 from "/src/assets/committee/profJagath.svg";
import speaker18 from "/src/assets/panel/speaker18.svg";


const keynoteSpeakers = [
{
    name: "Prof. Wang Yawei",
    affiliation:
      "Office of the Overseas Center for Environmental Science and Technology Cooperation, Chinese Academy of Sciences",
    image: speaker15,
    type: "keynote",
  },
  {
    name: "Dr. Norbu Wangchuk",
    affiliation: "South Asia Co-operative Environment Programme (SACEP)",
    image: speaker5,
    type: "keynote",
  },
  {
    name: "Dr. Moussa Baalbaki",
    affiliation: "INSEE Cement",
    image: speaker4,
    type: "keynote",
  },
  {
    name: "Mr. S. Vijayapala",
    affiliation: "United Nations Office for Project Services",
    image: speaker8,
    type: "keynote",
  },
  {
    name: "Dr. Chamila Dias",
    affiliation: "CESSD, The Open University of Sri Lanka",
    image: speaker3,
    type: "keynote",
  },
  {
    name: "Prof. Shiromi Karunaratne",
    affiliation: "Sri Lanka Institute of Information Technology",
    image: speaker13,
    type: "keynote",
  },
  {
    name: "Prof. Mahesh Jayaweera",
    affiliation: "University of Moratuwa",
    image: speaker12,
    type: "keynote",
  },
  {
    name: "Mr. W.D. Manoj",
    affiliation: "The Open University of Sri Lanka",
    image: speaker14,
    type: "keynote",
  },
  {
    name: "Prof. Jagath Manatunge",
    affiliation: "University of Moratuwa",
    image: speaker17,
    type: "keynote",
  },
  {
    name: "Eng. Buddhika Batheegama",
    affiliation: "INSEE Ecocyle Lanka",
    image: speaker6,
    type: "panel",
  },
  {
    name: "Mr. Rohan Jayaweera",
    title: "Panelist",
    affiliation: "John Keells Group",
    image: speaker16,
    type: "panel",
  },
  {
    name: "Eng. Heminda Jayaweera",
    affiliation: "TRACE",
    image: speaker9,
    type: "panel",
  },
  {
    name: "Mrs. Prashani Illangasekara",
    affiliation: "Hayleys PLC",
    image: speaker10,
    type: "panel",
  },
  {
    name: "Prof. Devaka K Weerakoon",
    affiliation: "University of Colombo",
    image: speaker18,
    type: "panel",
  },
  {
    name: "Mr. Kapila Rajapaksha",
    affiliation: "Central Environmental Authority",
    image: speaker1,
    type: "panel",
  },
  {
    name: "Dr. Ibrahim Mohammed",
    affiliation: "Maldives National University, Maldives",
    image: speaker2,
    type: "panel",
  },
  {
    name: "Mr. Palinda Perera",
    affiliation: "Rockland Distilleries (Pvt) Ltd",
    image: speaker11,
    type: "panel",
  },
];

const panelMembers = keynoteSpeakers.filter(
  (speaker) => speaker.type === "panel"
);
const keynoteOnly = keynoteSpeakers.filter(
  (speaker) => speaker.type === "keynote"
);
---

<BaseLayout
  title="Keynote Speakers & Agenda | ICPIES 2025"
  description="Meet our distinguished keynote speakers and view the conference agenda for ICPIES 2025"
>

  <!-- Keynote Speakers Section -->
  <section class="py-32 bg-gradient-to-b from-[#1A7A64]/5 to-white">
    <Container>
      <div class="text-center mb-12">
		<h1 class="text-4xl md:text-5xl font-bold text-[#2C3E50] mb-6">          Keynote Speakers & Panel Members
        </h1>
        <p class="text-[#2C3E50]/70 max-w-2xl mx-auto">
          Meet our distinguished keynote speakers and expert panel members who
          will share their expertise and insights
        </p>
      </div>

      <!-- All Speakers Grid -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
      >
		{
		  keynoteSpeakers.map((speaker, index) => (
			<div class="relative group bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100">
			  <div class="relative aspect-square overflow-hidden bg-gradient-to-br from-[#1A7A64]/10 to-[#4ECDC4]/10">
				<span
				  class={
					speaker.type === "keynote"
					  ? "absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-[#1A7A64] shadow-sm"
					  : "absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-[#0D3B66] shadow-sm"
				  }
				  aria-hidden="false"
				>
				  {speaker.type === "keynote" ? "Keynote" : "Panel"}
				</span>

				<Image
				  src={speaker.image}
				  alt={`Photo of ${speaker.name}`}
				  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
				  width={300}
				  height={300}
				/>
			  </div>

			  <div class="p-4">
				<h3 class="text-lg font-bold text-[#2C3E50] mb-1 line-clamp-2">
				  {speaker.name}
				</h3>
				<p class="text-[#2C3E50]/60 text-xs mb-3 line-clamp-2">
				  {speaker.affiliation}
				</p>
			  </div>
			</div>
		  ))
		}

      </div>
    </Container>
  </section>

  <!-- Conference Agenda Section -->
  <section class="py-20 bg-white">
    <Container>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#2C3E50] mb-4">
          Conference Agenda
        </h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div
          class="bg-gradient-to-r from-[#1A7A64]/5 to-[#4ECDC4]/5 rounded-xl p-8 border border-[#1A7A64]/10"
        >
          <div class="flex flex-col md:flex-row items-center gap-6">
            <div class="flex-1">
              <h3 class="text-xl font-semibold text-[#2C3E50] mb-2">
                ICPIES 2025 Conference Program
              </h3>
              <p class="text-[#2C3E50]/70 mb-4">
                Complete schedule including keynote sessions, panel discussions,
                workshops, and networking events.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="/Agenda-Inauguration-ICPIES-2025.pdf"
                  target="_blank"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-[#1A7A64] text-white font-medium rounded-lg hover:bg-[#156954] transition-colors"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path>
                  </svg>
                  View Online
                </a>
                <a
                  href="./Agenda-Inauguration-ICPIES-2025.pdf"
                  download
                  class="inline-flex items-center gap-2 px-4 py-2 border border-[#1A7A64] text-[#1A7A64] font-medium rounded-lg hover:bg-[#1A7A64] hover:text-white transition-colors"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                  Download PDF
                </a>
              </div>
            </div>
            <div
              class="w-full md:w-80 h-64 bg-gray-100 rounded-lg overflow-hidden"
            >
              <iframe
                src="/Agenda-Inauguration-ICPIES-2025.pdf"
                class="w-full h-full border-0"
                title="Conference Agenda Preview"></iframe>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Panel Discussion Section -->
  <section class="py-20 bg-gradient-to-b from-[#F8FAFC] to-white">
    <Container>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#2C3E50] mb-4">Panel Discussion</h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div
          class="bg-gradient-to-r from-[#8B5CF6]/5 to-[#A855F7]/5 rounded-xl p-8 border border-[#8B5CF6]/10"
        >
          <div class="flex flex-col md:flex-row items-center gap-6">
            <div class="flex-1">
              <h3 class="text-xl font-semibold text-[#2C3E50] mb-2">
                Expert Panel Discussion Details
              </h3>
              <p class="text-[#2C3E50]/70 mb-4">
                Comprehensive information about our panel discussion including
                topics, moderators, and discussion format.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="/Panel-Discussions-ICPIES-2025.pdf"
                  target="_blank"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-[#8B5CF6] text-white font-medium rounded-lg hover:bg-[#7C3AED] transition-colors"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path>
                  </svg>
                  View Details
                </a>
                <a
                  href="/Panel-Discussions-ICPIES-2025.pdf"
                  download
                  class="inline-flex items-center gap-2 px-4 py-2 border border-[#8B5CF6] text-[#8B5CF6] font-medium rounded-lg hover:bg-[#8B5CF6] hover:text-white transition-colors"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                  Download PDF
                </a>
              </div>
            </div>
            <div
              class="w-full md:w-80 h-64 bg-gray-100 rounded-lg overflow-hidden"
            >
              <iframe
                src="./Panel-Discussions-ICPIES-2025.pdf"
                class="w-full h-full border-0"
                title="Panel Discussion Details Preview"></iframe>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Call to Action Section -->
  <section class="py-20 bg-gradient-to-r from-[#1A7A64] to-[#4ECDC4]">
    <Container>
      <div class="text-center text-white">
        <h2 class="text-3xl font-bold mb-4">Ready to Join ICPIES 2025?</h2>
        <p class="text-lg mb-8 opacity-90 max-w-2xl mx-auto">
          Register now to attend these inspiring sessions and connect with
          leading experts in plastic innovation and environmental
          sustainability.
        </p>

        <div class="flex flex-col md:flex-row gap-4 justify-center">
          <a
            href="/registration"
            class="inline-flex items-center gap-2 px-8 py-4 bg-white text-[#1A7A64] font-semibold rounded-lg hover:bg-gray-50 transform hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M12 2.944l4.95 4.95M12 2.944l-4.95 4.95M12 21.056l4.95-4.95M12 21.056l-4.95-4.95"
              ></path>
            </svg>
            Register Now
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-[#1A7A64] transition-all duration-300"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Home
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* Smooth hover transitions */
  .group:hover img {
    transform: scale(1.05);
  }

  /* Custom scrollbar for PDF iframes */
  iframe {
    scrollbar-width: thin;
    scrollbar-color: #1a7a64 #f1f1f1;
  }

  iframe::-webkit-scrollbar {
    width: 6px;
  }

  iframe::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  iframe::-webkit-scrollbar-thumb {
    background: #1a7a64;
    border-radius: 3px;
  }

  iframe::-webkit-scrollbar-thumb:hover {
    background: #156954;
  }
</style>
