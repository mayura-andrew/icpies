---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/primitives/Container.astro";
import { Image } from "astro:assets";

import speaker1 from "/src/assets/panel/speaker1.svg";
import speaker2 from "/src/assets/panel/speaker2.svg";
import speaker3 from "/src/assets/panel/speaker3.svg";
import speaker4 from "/src/assets/panel/speaker4.svg";
import speaker5 from "/src/assets/panel/speaker5.svg";
import speaker6 from "/src/assets/panel/speaker6.svg";
import rathnasiri from "/src/assets/panel/rathnasiri.svg";
import speaker8 from "/src/assets/panel/speaker8.svg";
import speaker9 from "/src/assets/panel/speaker9.svg";
import speaker10 from "/src/assets/panel/speaker10.svg";
import speaker11 from "/src/assets/panel/speaker11.svg";
import speaker12 from "/src/assets/panel/speaker12.svg";
import speaker13 from "/src/assets/panel/speaker13.svg";
import speaker14 from "/src/assets/panel/speaker14.svg";
import speaker15 from "/src/assets/panel/speaker15.svg";
import speaker16 from "/src/assets/panel/speaker16.svg";
import speaker17 from "/src/assets/committee/profJagath.svg";
import speaker18 from "/src/assets/panel/speaker18.svg";
import prasad from "/src/assets/panel/prasad.svg"
import lalith from "/src/assets/panel/Lalith.svg"
import pasan from "/src/assets/panel/pasan.svg"
import vijayapalaImage from "/src/assets/speakers/vijayapala.svg"; // Replace with actual image path


const keynoteSpeakers = [
  {
    name: "Prof. Wang Yawei",
    affiliation:
      "Office of the Overseas Center for Environmental Science and Technology Cooperation, Chinese Academy of Sciences",
    image: speaker15,
    type: "keynote",
  },
  {
    name: "Dr. Norbu Wangchuk",
    affiliation: "South Asia Co-operative Environment Programme (SACEP)",
    image: speaker5,
    type: "keynote",
  },
  {
    name: "Dr. Moussa Baalbaki",
    affiliation: "Director - Products and Solutions Portfolio, INSEE Cement",
    image: speaker4,
    type: "keynote",
  },
  {
    name: "Vijayapala Sinnathamby",
    affiliation: "Sri Lanka Programme Manager, UNOPS",
    image: vijayapalaImage,
    type: "keynote",
  },
  {
    name: "Dr. Chamila Dias",
    affiliation: "CESSD, The Open University of Sri Lanka",
    image: speaker3,
    type: "keynote",
  },
  {
    name: "Prof. Shiromi Karunaratne",
    affiliation: "Sri Lanka Institute of Information Technology",
    image: speaker13,
    type: "keynote",
  },
  {
    name: "Prof. Mahesh Jayaweera",
    affiliation: "University of Moratuwa",
    image: speaker12,
    type: "keynote",
  },
  {
    name: "Mr. W.D. Manoj",
    affiliation: "The Open University of Sri Lanka",
    image: speaker14,
    type: "keynote",
  },
  {
    name: "Prof. Jagath Manatunge",
    affiliation: "University of Moratuwa",
    image: speaker17,
    type: "keynote",
  },
  {
    name: "Eng. Buddhika Batheegama",
    affiliation: "Business Development Manager, INSEE Ecocyle Lanka",
    image: speaker6,
    type: "panel",
  },
  {
    name: "Mr. Rohan Jayaweera",
    title: "Panelist",
    affiliation: "John Keells Group",
    image: speaker16,
    type: "panel",
  },
  {
    name: "Eng. Heminda Jayaweera",
    affiliation: "Executive Director, TRACE Sri Lanka",
    image: speaker9,
    type: "panel",
  },
  {
    name: "Mrs. Prashani Illangasekara",
    affiliation: "General Manager,Group ESG, Hayleys PLC",
    image: speaker10,
    type: "panel",
  },
  {
    name: "Prof. Devaka K Weerakoon",
    affiliation: "University of Colombo",
    image: speaker18,
    type: "panel",
  },
  {
    name: "Mr. Kapila Rajapaksha",
    affiliation: "Central Environmental Authority",
    image: speaker1,
    type: "panel",
  },
  {
    name: "Dr. Ibrahim Mohammed",
    affiliation: "Maldives National University, Maldives",
    image: speaker2,
    type: "panel",
  },
  {
    name: "Mr. Palinda Perera",
    affiliation: "Specialist, Corporate Responsibility, Rockland Distilleries (Pvt) Ltd",
    image: speaker11,
    type: "panel",
  },
  {
    name: "Prof. P.G. Rathnasiri",
    affiliation: "University of Moratuwa",
    image: rathnasiri,
    type: "panel",
  },
  {
    name: "Dr. Prasad Senadheera",
    affiliation: "Sri Lanka Country Director CIFOR-ICRAF",
    image: prasad,
    type: "panel",
  },
  {
    name: "Prof. Lalith Rajapakse",
    affiliation: "University of Moratuwa",
    image: lalith,
    type: "panel",
  },
  {
    name: "Mr. Pasan Senadheera",
    affiliation: "Assistant Manager Plasticcycle Operations, John Keells Group",
    image: pasan,
    type: "panel",
  },
];

// New structured groups (explicit ordering)
const honoraryGuests = [
  keynoteSpeakers.find((s) => s.name.includes("Wang Yawei")),
  keynoteSpeakers.find((s) => s.name.includes("Norbu Wangchuk")),
  keynoteSpeakers.find((s) => s.name.includes("Moussa Baalbaki")),
  keynoteSpeakers.find((s) => s.name.includes("Vijayapala Sinnathamby")),
].filter(Boolean);

const panels = [
  {
    title: "Panel Discussion — Session 1",
    moderator: keynoteSpeakers.find((s) => s.name.includes("Mahesh Jayaweera")),
    members: [
      keynoteSpeakers.find((s) => s.name.includes("Prashani Illangasekara")),
      keynoteSpeakers.find((s) => s.name.includes("Heminda Jayaweera")),
      keynoteSpeakers.find((s) => s.name.includes("Buddhika Batheegama")),
      keynoteSpeakers.find((s) => s.name.includes("Mr. Pasan Senadheera")), // duplicate allowed if needed
    ].filter(Boolean),
  },
  {
    title: "Panel Discussion — Session 2",
    moderator: keynoteSpeakers.find((s) => s.name.includes("Jagath Manatunge")),
    members: [
      keynoteSpeakers.find((s) => s.name.includes("Palinda Perera")),
      keynoteSpeakers.find((s) => s.name.includes("Ibrahim Mohammed")),
      keynoteSpeakers.find((s) => s.name.includes("Prof. Lalith Rajapakse")),
      keynoteSpeakers.find((s) => s.name.includes("Dr. Prasad Senadheera")),
	keynoteSpeakers.find((s) => s.name.includes("Prof. P.G. Rathnasiri")),

    ].filter(Boolean),
  },
];

const remainingSpeakers = keynoteSpeakers.filter(
  (s) =>
    !honoraryGuests.includes(s) &&
    !panels.some((p) => p.moderator === s) &&
    !panels.some((p) => p.members.includes(s))
);
---

<BaseLayout
  title="Keynote Speakers & Agenda | ICPIES 2025"
  description="Meet our distinguished keynote speakers and view the conference agenda for ICPIES 2025"
>
  <!-- Keynote Speakers Section -->
  <section class="py-32 bg-gradient-to-b from-[#1A7A64]/5 to-white">
    <Container>
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-[#2C3E50] mb-6">
          Keynote Speakers & Panel Members
        </h1>
        <p class="text-[#2C3E50]/70 max-w-2xl mx-auto">
          Meet our distinguished keynote speakers and expert panel members who
          will share their expertise and insights
        </p>
      </div>

      <!-- Honorary Guests (prominent, ordered) -->
      <div class="mb-12">
        <!-- <h2 class="text-2xl font-semibold text-[#2C3E50] mb-6">
          Address by Honorary Guest
        </h2> -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            honoraryGuests.map((g) => (
              <article class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">
                <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#1A7A64]/10 to-[#4ECDC4]/10">
                  <Image
                    src={g.image}
                    alt={`Photo of ${g.name}`}
                    class="w-full h-full object-cover"
                    width={600}
                    height={450}
                  />
                </div>
                <div class="p-4">
                  <h3 class="text-lg font-bold text-[#2C3E50]">{g.name}</h3>
                  <p class="text-sm text-[#2C3E50]/70 mt-1">{g.affiliation}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Panels: each panel shows moderator then members -->
      {
        panels.map((panel) => (
          <section class="mb-10 bg-white rounded-xl p-6 border border-[#E6F4EF]">
            <div class="flex items-center justify-between mb-6">
              <h3 class="text-xl font-semibold text-[#2C3E50]">
                {panel.title}
              </h3>
              <span class="text-sm text-[#2C3E50]/60">Moderated session</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {/* Moderator - emphasized */}
              <div class="md:col-span-1 flex items-stretch">
                <article class="w-full bg-gradient-to-br from-[#F1F7F5] to-white border border-[#E6F4EF] rounded-lg p-4 flex flex-col items-center text-center">
                  <div class="w-36 h-36 rounded-full overflow-hidden mb-4 ring-2 ring-[#1A7A64]/15">
                    <Image
                      src={panel.moderator.image}
                      alt={`Photo of ${panel.moderator.name}`}
                      class="w-full h-full object-cover"
                      width={300}
                      height={300}
                    />
                  </div>
                  <span class="inline-block px-3 py-1 mb-2 text-xs font-semibold rounded-full bg-[#1A7A64] text-white">
                    Moderator
                  </span>
                  <h4 class="text-md font-bold text-[#2C3E50]">
                    {panel.moderator.name}
                  </h4>
                  <p class="text-xs text-[#2C3E50]/70 mt-1">
                    {panel.moderator.affiliation}
                  </p>
                </article>
              </div>

              {/* Members */}
              <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
                {panel.members.map((member) => (
                  <article class="bg-white rounded-lg border border-gray-100 p-3 flex items-start gap-3">
                    <div class="w-24 h-24 rounded-md overflow-hidden flex-shrink-0">
                      <Image
                        src={member.image}
                        alt={`Photo of ${member.name}`}
                        class="w-full h-full object-cover"
                        width={96}
                        height={96}
                      />
                    </div>
                    <div>
                      <h5 class="font-semibold text-sm text-[#2C3E50]">
                        {member.name}
                      </h5>
                      <p class="text-xs text-[#2C3E50]/70 mt-1">
                        {member.affiliation}
                      </p>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>
        ))
      }

      <!-- Remaining speakers (other keynotes / panelists) -->
      <!-- {
        remainingSpeakers.length > 0 && (
          <div class="mt-8">
            <h3 class="text-xl font-semibold text-[#2C3E50] mb-4">
              Other Speakers
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {remainingSpeakers.map((s) => (
                <div class="relative group bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100">
                  <div class="relative aspect-square overflow-hidden bg-gradient-to-br from-[#1A7A64]/10 to-[#4ECDC4]/10">
                    <span
                      class={
                        s.type === "keynote"
                          ? "absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-[#1A7A64] shadow-sm"
                          : "absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold text-white bg-[#0D3B66] shadow-sm"
                      }
                      aria-hidden="false"
                    >
                      {s.type === "keynote" ? "Keynote" : "Panel"}
                    </span>
                    <Image
                      src={s.image}
                      alt={`Photo of ${s.name}`}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      width={300}
                      height={300}
                    />
                  </div>
                  <div class="p-4">
                    <h3 class="text-lg font-bold text-[#2C3E50] mb-1 line-clamp-2">
                      {s.name}
                    </h3>
                    <p class="text-[#2C3E50]/60 text-xs mb-3 line-clamp-2">
                      {s.affiliation}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      } -->
    </Container>
  </section>

  <!-- Conference Agenda Section -->
  <section class="py-20 bg-white">
    <Container>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#2C3E50] mb-4">
          Conference Agenda
        </h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div
          class="bg-gradient-to-r from-[#1A7A64]/5 to-[#4ECDC4]/5 rounded-xl p-8 border border-[#1A7A64]/10"
        >
          <div class="flex flex-col md:flex-row items-center gap-6">
            <div class="flex-1">
              <h3 class="text-xl font-semibold text-[#2C3E50] mb-2">
                ICPIES 2025 Conference Program
              </h3>
              <p class="text-[#2C3E50]/70 mb-4">
                Complete schedule including keynote sessions, panel discussions,
                workshops, and networking events.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="/Agenda-Inauguration-ICPIES-2025.pdf"
                  target="_blank"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-[#1A7A64] text-white font-medium rounded-lg hover:bg-[#156954] transition-colors"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path>
                  </svg>
                  View Online
                </a>
                <a
                  href="./Agenda-Inauguration-ICPIES-2025.pdf"
                  download
                  class="inline-flex items-center gap-2 px-4 py-2 border border-[#1A7A64] text-[#1A7A64] font-medium rounded-lg hover:bg-[#1A7A64] hover:text-white transition-colors"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                  Download PDF
                </a>
              </div>
            </div>
            <div
              class="w-full md:w-80 h-64 bg-gray-100 rounded-lg overflow-hidden"
            >
              <iframe
                src="/Agenda-Inauguration-ICPIES-2025.pdf"
                class="w-full h-full border-0"
                title="Conference Agenda Preview"></iframe>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Panel Discussion Section -->
  <section class="py-20 bg-gradient-to-b from-[#F8FAFC] to-white">
    <Container>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#2C3E50] mb-4">Panel Discussion</h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div
          class="bg-gradient-to-r from-[#8B5CF6]/5 to-[#A855F7]/5 rounded-xl p-8 border border-[#8B5CF6]/10"
        >
          <div class="flex flex-col md:flex-row items-center gap-6">
            <div class="flex-1">
              <h3 class="text-xl font-semibold text-[#2C3E50] mb-2">
                Expert Panel Discussion Details
              </h3>
              <p class="text-[#2C3E50]/70 mb-4">
                Comprehensive information about our panel discussion including
                topics, moderators, and discussion format.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="/Panel-Discussions-ICPIES-2025.pdf"
                  target="_blank"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-[#8B5CF6] text-white font-medium rounded-lg hover:bg-[#7C3AED] transition-colors"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path>
                  </svg>
                  View Details
                </a>
                <a
                  href="/Panel-Discussions-ICPIES-2025.pdf"
                  download
                  class="inline-flex items-center gap-2 px-4 py-2 border border-[#8B5CF6] text-[#8B5CF6] font-medium rounded-lg hover:bg-[#8B5CF6] hover:text-white transition-colors"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                  Download PDF
                </a>
              </div>
            </div>
            <div
              class="w-full md:w-80 h-64 bg-gray-100 rounded-lg overflow-hidden"
            >
              <iframe
                src="./Panel-Discussions-ICPIES-2025.pdf"
                class="w-full h-full border-0"
                title="Panel Discussion Details Preview"></iframe>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Call to Action Section -->
  <section class="py-20 bg-gradient-to-r from-[#1A7A64] to-[#4ECDC4]">
    <Container>
      <div class="text-center text-white">
        <h2 class="text-3xl font-bold mb-4">Ready to Join ICPIES 2025?</h2>
        <p class="text-lg mb-8 opacity-90 max-w-2xl mx-auto">
          Register now to attend these inspiring sessions and connect with
          leading experts in plastic innovation and environmental
          sustainability.
        </p>

        <div class="flex flex-col md:flex-row gap-4 justify-center">
          <a
            href="/registration"
            class="inline-flex items-center gap-2 px-8 py-4 bg-white text-[#1A7A64] font-semibold rounded-lg hover:bg-gray-50 transform hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M12 2.944l4.95 4.95M12 2.944l-4.95 4.95M12 21.056l4.95-4.95M12 21.056l-4.95-4.95"
              ></path>
            </svg>
            Register Now
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-[#1A7A64] transition-all duration-300"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Home
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* Smooth hover transitions */
  .group:hover img {
    transform: scale(1.05);
  }

  /* Custom scrollbar for PDF iframes */
  iframe {
    scrollbar-width: thin;
    scrollbar-color: #1a7a64 #f1f1f1;
  }

  iframe::-webkit-scrollbar {
    width: 6px;
  }

  iframe::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  iframe::-webkit-scrollbar-thumb {
    background: #1a7a64;
    border-radius: 3px;
  }

  iframe::-webkit-scrollbar-thumb:hover {
    background: #156954;
  }
</style>
