---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/primitives/Container.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout
  title="Past Proceedings - ICPIES"
  description="View past conference proceedings and publications from ICPIES conferences"
>
  <Container>
    <div class="py-24">
      <!-- Header Section -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Past Proceedings
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Explore research papers and publications from previous ICPIES conferences
        </p>
      </div>

      <!-- PDF Viewer Section -->
      <div class="max-w-6xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden border">
          <!-- PDF Controls -->
          <div class="bg-gray-50 px-4 py-3 border-b flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-2">
              <Icon name="heroicons:document-text" class="w-5 h-5 text-[#1A7A64]" />
              <h2 class="font-semibold text-gray-900">ICPIES 2024 Proceedings</h2>
            </div>

            <div class="flex items-center gap-2">
              <!-- Zoom Controls -->
              <button id="zoom-out" class="p-2 rounded hover:bg-gray-200 transition-colors" title="Zoom Out">
                <Icon name="heroicons:minus" class="w-4 h-4" />
              </button>
              <span id="zoom-level" class="text-sm font-medium min-w-[60px] text-center">100%</span>
              <button id="zoom-in" class="p-2 rounded hover:bg-gray-200 transition-colors" title="Zoom In">
                <Icon name="heroicons:plus" class="w-4 h-4" />
              </button>

              <!-- Fullscreen -->
              <button id="fullscreen" class="p-2 rounded hover:bg-gray-200 transition-colors" title="Fullscreen">
                <Icon name="heroicons:arrows-pointing-out" class="w-4 h-4" />
              </button>

              <!-- Download -->
              <a
                href="/proceedings.pdf"
                download
                class="flex items-center gap-2 bg-[#1A7A64] text-white px-4 py-2 rounded hover:bg-[#145a4a] transition-colors"
              >
                <Icon name="heroicons:arrow-down-tray" class="w-4 h-4" />
                <span class="hidden sm:inline">Download</span>
              </a>
            </div>
          </div>

          <!-- PDF Container -->
          <div id="pdf-container" class="relative bg-gray-100">
            <!-- Loading Spinner -->
            <div id="loading" class="flex items-center justify-center py-32">
              <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-[#1A7A64]"></div>
              <span class="ml-3 text-gray-600">Loading PDF...</span>
            </div>

            <!-- PDF Canvas -->
            <div id="pdf-viewer" class="hidden">
              <canvas id="pdf-canvas" class="w-full h-auto mx-auto block"></canvas>
            </div>

            <!-- Error Message -->
            <div id="pdf-error" class="hidden text-center py-32">
              <Icon name="heroicons:exclamation-triangle" class="w-16 h-16 text-red-500 mx-auto mb-4" />
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Failed to load PDF</h3>
              <p class="text-gray-600 mb-4">There was an error loading the PDF document.</p>
              <button
                id="retry-btn"
                class="bg-[#1A7A64] text-white px-6 py-2 rounded hover:bg-[#145a4a] transition-colors"
              >
                Try Again
              </button>
            </div>

            <!-- Mobile Fallback -->
            <div id="mobile-fallback" class="hidden md:hidden text-center py-16 px-4">
              <Icon name="heroicons:device-phone-mobile" class="w-16 h-16 text-gray-400 mx-auto mb-4" />
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Mobile View</h3>
              <p class="text-gray-600 mb-6">For the best experience on mobile, download the PDF to view.</p>
              <a
                href="/proceedings.pdf"
                download
                class="inline-flex items-center gap-2 bg-[#1A7A64] text-white px-6 py-3 rounded-lg hover:bg-[#145a4a] transition-colors"
              >
                <Icon name="heroicons:arrow-down-tray" class="w-5 h-5" />
                Download PDF
              </a>
            </div>
          </div>

          <!-- Page Navigation -->
          <div id="page-controls" class="hidden bg-gray-50 px-4 py-3 border-t flex items-center justify-between">
            <button
              id="prev-page"
              class="flex items-center gap-2 px-4 py-2 rounded hover:bg-gray-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
              disabled
            >
              <Icon name="heroicons:chevron-left" class="w-4 h-4" />
              Previous
            </button>

            <div class="flex items-center gap-4">
              <span>Page</span>
              <input
                id="page-input"
                type="number"
                min="1"
                value="1"
                class="w-16 px-2 py-1 border rounded text-center"
              />
              <span>of <span id="total-pages">0</span></span>
            </div>

            <button
              id="next-page"
              class="flex items-center gap-2 px-4 py-2 rounded hover:bg-gray-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Next
              <Icon name="heroicons:chevron-right" class="w-4 h-4" />
            </button>
          </div>
        </div>

        <!-- Additional Information -->
        <div class="mt-8 grid md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-lg shadow border">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">About This Publication</h3>
            <ul class="space-y-2 text-gray-600">
              <li><strong>Conference:</strong> ICPIES 2024</li>
              <li><strong>Date:</strong> September 2024</li>
              <li><strong>Pages:</strong> 150+</li>
              <li><strong>Format:</strong> PDF</li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-lg shadow border">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Access Options</h3>
            <div class="space-y-3">
              <a
                href="/proceedings.pdf"
                target="_blank"
                class="flex items-center gap-2 text-[#1A7A64] hover:underline"
              >
                <Icon name="heroicons:arrow-top-right-on-square" class="w-4 h-4" />
                Open in New Tab
              </a>
              <a
                href="/proceedings.pdf"
                download
                class="flex items-center gap-2 text-[#1A7A64] hover:underline"
              >
                <Icon name="heroicons:arrow-down-tray" class="w-4 h-4" />
                Download PDF
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  // PDF.js Configuration
  const pdfUrl = '/proceedings.pdf'; // Update this path
  let pdfDoc = null;
  let pageNum = 1;
  let pageRendering = false;
  let pageNumPending = null;
  let scale = 1.0;
  let canvas = null;
  let ctx = null;

  // Initialize PDF viewer
  async function initPDFViewer() {
    try {
      // Import PDF.js (you'll need to add this to your project)
      const pdfjsLib = window['pdfjs-dist/build/pdf'];
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

      // Check if mobile
      const isMobile = window.innerWidth < 768;

      if (isMobile) {
        document.getElementById('mobile-fallback').classList.remove('hidden');
        document.getElementById('loading').classList.add('hidden');
        return;
      }

      // Load PDF
      const loadingTask = pdfjsLib.getDocument(pdfUrl);
      pdfDoc = await loadingTask.promise;

      // Show total pages
      document.getElementById('total-pages').textContent = pdfDoc.numPages;

      // Initialize canvas
      canvas = document.getElementById('pdf-canvas');
      ctx = canvas.getContext('2d');

      // Show PDF viewer and hide loading
      document.getElementById('pdf-viewer').classList.remove('hidden');
      document.getElementById('page-controls').classList.remove('hidden');
      document.getElementById('loading').classList.add('hidden');

      // Render first page
      renderPage(pageNum);

    } catch (error) {
      console.error('Error loading PDF:', error);
      showError();
    }
  }

  // Render specific page
  function renderPage(num) {
    if (pageRendering) {
      pageNumPending = num;
      return;
    }
    pageRendering = true;

    pdfDoc.getPage(num).then(function(page) {
      const viewport = page.getViewport({ scale: scale });
      canvas.height = viewport.height;
      canvas.width = viewport.width;

      const renderContext = {
        canvasContext: ctx,
        viewport: viewport
      };

      const renderTask = page.render(renderContext);

      renderTask.promise.then(function() {
        pageRendering = false;
        if (pageNumPending !== null) {
          renderPage(pageNumPending);
          pageNumPending = null;
        }
      });
    });

    // Update page number
    document.getElementById('page-input').value = num;

    // Update navigation buttons
    document.getElementById('prev-page').disabled = (num <= 1);
    document.getElementById('next-page').disabled = (num >= pdfDoc.numPages);
  }

  // Show error message
  function showError() {
    document.getElementById('loading').classList.add('hidden');
    document.getElementById('pdf-error').classList.remove('hidden');
  }

  // Event listeners
  document.addEventListener('DOMContentLoaded', function() {
    // Check if PDF.js is available
    if (typeof window !== 'undefined' && !window['pdfjs-dist/build/pdf']) {
      // Load PDF.js from CDN
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
      script.onload = initPDFViewer;
      document.head.appendChild(script);
    } else {
      initPDFViewer();
    }

    // Navigation controls
    document.getElementById('prev-page').addEventListener('click', function() {
      if (pageNum <= 1) return;
      pageNum--;
      renderPage(pageNum);
    });

    document.getElementById('next-page').addEventListener('click', function() {
      if (pageNum >= pdfDoc.numPages) return;
      pageNum++;
      renderPage(pageNum);
    });

    // Page input
    document.getElementById('page-input').addEventListener('change', function() {
      const newPage = parseInt(this.value);
      if (newPage > 0 && newPage <= pdfDoc.numPages) {
        pageNum = newPage;
        renderPage(pageNum);
      } else {
        this.value = pageNum;
      }
    });

    // Zoom controls
    document.getElementById('zoom-in').addEventListener('click', function() {
      scale = Math.min(scale + 0.25, 3.0);
      document.getElementById('zoom-level').textContent = Math.round(scale * 100) + '%';
      renderPage(pageNum);
    });

    document.getElementById('zoom-out').addEventListener('click', function() {
      scale = Math.max(scale - 0.25, 0.5);
      document.getElementById('zoom-level').textContent = Math.round(scale * 100) + '%';
      renderPage(pageNum);
    });

    // Fullscreen
    document.getElementById('fullscreen').addEventListener('click', function() {
      const container = document.getElementById('pdf-container');
      if (container.requestFullscreen) {
        container.requestFullscreen();
      } else if (container.webkitRequestFullscreen) {
        container.webkitRequestFullscreen();
      } else if (container.mozRequestFullScreen) {
        container.mozRequestFullScreen();
      }
    });

    // Retry button
    document.getElementById('retry-btn').addEventListener('click', function() {
      document.getElementById('pdf-error').classList.add('hidden');
      document.getElementById('loading').classList.remove('hidden');
      initPDFViewer();
    });

    // Responsive handling
    window.addEventListener('resize', function() {
      if (window.innerWidth < 768) {
        document.getElementById('pdf-viewer').classList.add('hidden');
        document.getElementById('page-controls').classList.add('hidden');
        document.getElementById('mobile-fallback').classList.remove('hidden');
      } else if (pdfDoc) {
        document.getElementById('pdf-viewer').classList.remove('hidden');
        document.getElementById('page-controls').classList.remove('hidden');
        document.getElementById('mobile-fallback').classList.add('hidden');
      }
    });
  });
</script>

<style>
  #pdf-container {
    min-height: 600px;
  }

  #pdf-canvas {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    #pdf-container {
      min-height: 400px;
    }
  }

  /* Fullscreen styles */
  #pdf-container:fullscreen {
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #pdf-container:fullscreen #pdf-canvas {
    max-height: 100vh;
    max-width: 100vw;
  }
</style>
