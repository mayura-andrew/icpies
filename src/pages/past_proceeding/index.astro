---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/primitives/Container.astro";
import { Icon } from "astro-icon/components";
import { proceedingsData } from "@/data/proceedings";

const seo = {
  title: "Past Proceedings | ICPIES Conference",
  description: "Explore research papers and publications from previous ICPIES conferences"
};
---

<BaseLayout seo={seo}>
  <div class="py-16 pb-32">
    <!-- Header Section -->
    <section class="py-16 bg-gradient-to-b from-[#1A7A64]/5 to-white rounded-2xl">
      <Container>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-[#2C3E50] mb-6">
            Past Proceedings
          </h1>
          <div class="w-32 h-1 bg-gradient-to-r from-[#1A7A64] to-[#4ECDC4] rounded-full mx-auto mb-8"></div>
          <p class="text-lg text-[#2C3E50]/80 max-w-2xl mx-auto">
            Explore research papers and publications from previous ICPIES conferences
          </p>
        </div>
      </Container>
    </section>

    <!-- Proceedings Cards -->
    <section class="py-16">
      <Container>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
          {proceedingsData.map((proceeding) => (
            <div class="bg-white rounded-lg shadow-lg overflow-hidden border hover:shadow-xl transition-shadow">
              <div class="bg-gradient-to-r from-[#1A7A64] to-[#4ECDC4] p-6 text-white">
                <h2 class="text-3xl font-bold mb-2">{proceeding.year}</h2>
                <p class="text-sm opacity-90">{proceeding.date}</p>
              </div>

              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 mb-3">{proceeding.title}</h3>
                {proceeding.description && (
                  <p class="text-gray-600 mb-4 text-sm">{proceeding.description}</p>
                )}

                {proceeding.highlights && (
                  <ul class="space-y-2 mb-6">
                    {proceeding.highlights.map((highlight) => (
                      <li class="flex items-start gap-2 text-sm text-gray-700">
                        <Icon name="heroicons:check-circle" class="w-5 h-5 text-[#1A7A64] flex-shrink-0 mt-0.5" />
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="space-y-2 text-sm text-gray-600 mb-6">
                  <p><strong>Pages:</strong> {proceeding.pages}</p>
                </div>

                <div class="flex gap-3">
                  <a
                    href={`/past_proceeding/${proceeding.year}`}
                    class="flex-1 flex items-center justify-center gap-2 bg-[#1A7A64] text-white px-4 py-2 rounded hover:bg-[#145a4a] transition-colors text-center"
                  >
                    <Icon name="heroicons:document-text" class="w-4 h-4" />
                    View Online
                  </a>
                  <a
                    href={proceeding.pdfUrl}
                    download
                    class="flex items-center justify-center gap-2 border-2 border-[#1A7A64] text-[#1A7A64] px-4 py-2 rounded hover:bg-[#1A7A64] hover:text-white transition-colors"
                    title="Download PDF"
                  >
                    <Icon name="heroicons:arrow-down-tray" class="w-4 h-4" />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>
  </div>
</BaseLayout>
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              <div class="ml-3 flex-1">
                <h3 class="text-sm font-medium text-yellow-800">
                  PDF Viewer Not Ready
                </h3>
                <div class="mt-2 text-sm text-yellow-700">
                  <p>The PDF viewer is still loading. This may take a moment on the first visit.</p>
                </div>
                <div class="mt-4">
                  <button
                    id="retry-pdf-load"
                    class="inline-flex items-center gap-2 bg-yellow-600 text-white px-4 py-2 rounded-md hover:bg-yellow-700 transition-colors font-medium"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Try Again
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Container>
    </section>
  </div>
</BaseLayout>


<style>
  #pdf-container {
    min-height: 600px;
  }

  #pdf-canvas {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    #pdf-container {
      min-height: 400px;
    }
  }

  /* Fullscreen styles */
  #pdf-container:fullscreen {
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #pdf-container:fullscreen #pdf-canvas {
    max-height: 100vh;
    max-width: 100vw;
  }
</style>

