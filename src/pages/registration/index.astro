				</p>
				<div class="inline-flex items-center px-4 py-2 bg-[#F39C12]/10 rounded-full">
				  <svg class="w-4 h-4 text-[#F39C12] mr-2" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
				  </svg>
				  <span class="text-sm font-medium text-[#F39C12]">Expected Launch: September 2025</span>
				</div>
			  </div>
			  <!-- Disabled Payment Button -->
			  <div class="mt-6 text-center">
				<button
				  disabled
				  class="bg-gray-400 text-white font-semibold py-3 px-8 rounded-lg cursor-not-allowed opacity-60 flex items-center mx-auto"
				>
				  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
				  </svg>
				  Payment Gateway (Coming Soon)
				</button>
			  </div>
			</div>

			<!-- Step 2: Registration Form - Updated Priority -->
			<div class="bg-white rounded-xl shadow-lg p-8 border-2 border-[#1A7A64]">
			  <h2 class="text-2xl font-bold text-[#2C3E50] mb-6 flex items-center">
				<span class="w-8 h-8 bg-[#0D3B66] text-white rounded-full flex items-center justify-center text-sm font-bold mr-3">2</span>
				Registration Form
			  </h2>

			  <!-- Coming Soon Section for Registration Form -->
			  <div class="text-center py-12 bg-gradient-to-r from-[#F39C12]/5 to-[#E67E22]/5 rounded-lg border-2 border-dashed border-[#F39C12]/30">
				<svg class="w-16 h-16 text-[#F39C12] mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
				</svg>
				<p class="text-lg font-semibold text-[#E67E22] mb-2">
				  Coming Soon!
				</p>
				<div class="inline-flex items-center px-4 py-2 bg-[#F39C12]/10 rounded-full">
				  <svg class="w-4 h-4 text-[#F39C12] mr-2" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
				  </svg>
				  <span class="text-sm font-medium text-[#F39C12]">Expected Launch: September 2025</span>
				</div>
			  </div>
			</div>

