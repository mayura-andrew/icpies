---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Registration | ICPIES 2025"
  description="Register for ICPIES 2025 Conference"
>
  <section class="py-32 bg-gradient-to-b from-[#0D3B66]/5 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-[#2C3E50] mb-6">
          ICPIES 2025 Registration
        </h1>
        <div
          class="w-32 h-1 bg-gradient-to-r from-[#0D3B66] to-[#4ECDC4] rounded-full mx-auto mb-8"
        >
        </div>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Please follow the instructions below for completing your ICPIES 2025
          registration. Only online payments via the official payment gateway
          are accepted.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Section 1: Payment Guidelines -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-xl shadow-lg p-6 sticky top-24">
            <h2
              class="text-2xl font-bold text-[#2C3E50] mb-6 flex items-center"
            >
              <svg
                class="w-6 h-6 text-[#1A7A64] mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
              Payment Guidelines
            </h2>

            <!-- Registration Includes -->
            <div
              class="mb-6 p-4 bg-[#1A7A64]/5 rounded-lg border-l-4 border-[#1A7A64]"
            >
              <h3 class="text-lg font-semibold text-[#1A7A64] mb-3">
                Registration Includes
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li class="flex items-start">
                  <svg
                    class="w-4 h-4 text-[#1A7A64] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Access to all sessions
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-4 h-4 text-[#1A7A64] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Conference proceedings publication
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-4 h-4 text-[#1A7A64] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Conference attendance e-certificate
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-4 h-4 text-[#1A7A64] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Digital conference materials
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-4 h-4 text-[#1A7A64] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Networking opportunities
                </li>
              </ul>
            </div>

            <!-- Payment Method -->
            <div class="mb-6">
              <h3 class="text-lg font-semibold text-[#2C3E50] mb-4">
                1. Payment Method
              </h3>
              <div
                class="p-4 bg-[#0D3B66]/5 rounded-lg border-l-4 border-[#0D3B66]"
              >
                <h4 class="font-medium text-[#0D3B66] mb-2">
                  Debit/Credit Card (Online Gateway)
                </h4>
                <ul class="space-y-1 text-sm text-gray-700">
                  <li>• Currency: Local and Foreign</li>
                  <li>• Bank Service Fee may be applicable</li>
                  <li>• Exchange Rate: 1 USD = LKR 305 (subject to change)</li>
                  <li>• Upload proof via registration form after payment</li>
                </ul>
              </div>
            </div>

            <!-- Registration Fees -->
            <div class="mb-6">
              <h3 class="text-lg font-semibold text-[#2C3E50] mb-4">
                Registration Fees
              </h3>

              <!-- Local Participants -->
              <div
                class="mb-4 p-4 bg-[#1A7A64]/5 rounded-lg border-l-4 border-[#1A7A64]"
              >
                <h4 class="font-medium text-[#1A7A64] mb-2">
                  Local Participants
                </h4>
                <div class="space-y-1 text-sm">
                  <div class="flex justify-between">
                    <span>General Registration:</span>
                    <span class="font-semibold">LKR 5,000</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Early Bird:</span>
                    <span class="font-semibold">LKR 3,500</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Students:</span>
                    <span class="font-semibold">LKR 3,000</span>
                  </div>
                </div>
              </div>

              <!-- Foreign Participants -->
              <div
                class="mb-4 p-4 bg-[#0D3B66]/5 rounded-lg border-l-4 border-[#0D3B66]"
              >
                <h4 class="font-medium text-[#0D3B66] mb-2">
                  Foreign Participants
                </h4>
                <div class="space-y-1 text-sm">
                  <div class="flex justify-between">
                    <span>General Registration:</span>
                    <span class="font-semibold">USD 150</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Early Bird:</span>
                    <span class="font-semibold">USD 100</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Online Participation:</span>
                    <span class="font-semibold">USD 50</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Post-Payment Process -->
            <div class="mb-6">
              <h3 class="text-lg font-semibold text-[#2C3E50] mb-4">
                2. Post-Payment
              </h3>
              <div class="space-y-2 text-sm text-gray-700">
                <div class="flex items-start">
                  <span class="w-2 h-2 bg-[#4ECDC4] rounded-full mr-2 mt-2"
                  ></span>
                  <span>Upload payment proof via registration form</span>
                </div>
                <div class="flex items-start">
                  <span class="w-2 h-2 bg-[#4ECDC4] rounded-full mr-2 mt-2"
                  ></span>
                  <span>Receive formal email confirmation of registration</span>
                </div>
              </div>
            </div>

            <!-- Important Notes -->
            <div class="p-4 bg-amber-50 border border-amber-200 rounded-lg">
              <div class="flex items-start">
                <svg
                  class="w-5 h-5 text-amber-600 mr-2 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                    clip-rule="evenodd"></path>
                </svg>
                <div class="text-sm">
                  <p class="font-medium text-amber-800 mb-1">
                    3. Important Notes
                  </p>
                  <ul class="text-amber-700 space-y-1">
                    <li>• Online payment is the only accepted method</li>
                    <li>
                      • Payments must be completed by the registration deadline
                    </li>
                    <li>
                      • Keep a copy of the confirmation and receipt for your
                      records
                    </li>
                    <li
                      class="font-semibold text-amber-900 bg-amber-100 px-2 py-1 rounded border-l-2 border-amber-600"
                    >
                      📸 Keep a screenshot of the confirmation for your records
                      and upload it to the Registration Form
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 2: Registration Steps -->
        <div class="lg:col-span-2">
          <div class="space-y-8">
            <!-- Step 1: Online Payment Form -->
            <div class="bg-white rounded-xl shadow-lg p-8">
              <h2
                class="text-2xl font-bold text-[#2C3E50] mb-6 flex items-center"
              >
                <span
                  class="w-8 h-8 bg-[#1A7A64] text-white rounded-full flex items-center justify-center text-sm font-bold mr-3"
                  >1</span
                >
                Online Payment Process
              </h2>

              <!-- Active Payment Section -->
              <div
                class="text-center py-12 bg-gradient-to-r from-[#1A7A64]/5 to-[#4ECDC4]/5 rounded-lg border-2 border-solid border-[#1A7A64]/30 mb-6"
              >
                <div class="text-center">
                  <a
                    href="https://icpies.ou.ac.lk/payment/"
                    target="_blank"
                    class="bg-gradient-to-r from-[#1A7A64] to-[#4ECDC4] text-white font-semibold py-4 px-8 rounded-lg hover:from-[#156954] hover:to-[#3bb8b0] transform hover:-translate-y-1 hover:shadow-lg transition-all duration-300 inline-flex items-center"
                  >
                    <svg
                      class="w-5 h-5 mr-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                      ></path>
                    </svg>
                    Proceed to Payment Gateway
                  </a>
                  <p class="text-sm text-gray-600 mt-3">
                    <strong>Note:</strong> You will be redirected to our secure payment
                    portal
                  </p>
                </div>
              </div>
            </div>

            <!-- Step 2: Registration Form - Updated Priority -->
            <div
              class="bg-white rounded-xl shadow-lg p-8 border-2 border-[#1A7A64]"
            >
              <h2
                class="text-2xl font-bold text-[#2C3E50] mb-6 flex items-center"
              >
                <span
                  class="w-8 h-8 bg-[#0D3B66] text-white rounded-full flex items-center justify-center text-sm font-bold mr-3"
                  >2</span
                >
                Registration Form
              </h2>

              <!-- Active Registration Form Section -->
              <div
                class="text-center py-12 bg-gradient-to-r from-[#0D3B66]/5 to-[#1A7A64]/5 rounded-lg border-2 border-solid border-[#0D3B66]/30"
              >
                <div class="text-center">
                  <a
                    href="https://docs.google.com/forms/d/e/1FAIpQLSf8-mLy-j6gemAo4qOJVVrKXLEt7X8bgQt2kvZ_jsWDGi5lkg/viewform?usp=send_form"
                    target="_blank"
                    class="bg-gradient-to-r from-[#0D3B66] to-[#1A7A64] text-white font-semibold py-4 px-8 rounded-lg hover:from-[#0a2d52] hover:to-[#156954] transform hover:-translate-y-1 hover:shadow-lg transition-all duration-300 inline-flex items-center"
                  >
                    <svg
                      class="w-5 h-5 mr-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-10a2 2 0 00-2-2h-4M14 4v8m0 0l3-3m-3 3L11 9"
                      ></path>
                    </svg>
                    Complete Registration Form
                  </a>
                  <p class="text-sm text-gray-600 mt-3">
                    <strong>Note:</strong> You will be redirected to our secure registration
                    form
                  </p>
                </div>
              </div>
            </div>

            <!-- Contact Information -->
            <div class="bg-white rounded-xl shadow-lg p-8">
              <h2
                class="text-2xl font-bold text-[#2C3E50] mb-6 flex items-center"
              >
                <svg
                  class="w-6 h-6 text-[#1A7A64] mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
                Need Assistance?
              </h2>

              <p class="text-gray-600 mb-6">
                For further inquiries or assistance with registration and
                payment, please contact us at:
              </p>

              <div class="grid md:grid-cols-2 gap-6">
                <div
                  class="p-4 bg-[#1A7A64]/5 rounded-lg border-l-4 border-[#1A7A64]"
                >
                  <h3 class="font-semibold text-[#1A7A64] mb-2">Email</h3>
                  <a
                    href="mailto:icpies@ou.ac.lk"
                    class="text-[#1A7A64] hover:underline">icpies@ou.ac.lk</a
                  >
                </div>

                <div
                  class="p-4 bg-[#0D3B66]/5 rounded-lg border-l-4 border-[#0D3B66]"
                >
                  <h3 class="font-semibold text-[#0D3B66] mb-2">Phone</h3>
                  <a
                    href="tel:+94112881423"
                    class="text-[#0D3B66] hover:underline">+94 11 2881111</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // Fee Calculator
      const countrySelect = document.getElementById(
        "calc-country"
      ) as HTMLSelectElement | null;
      const typeSelect = document.getElementById(
        "calc-type"
      ) as HTMLSelectElement | null;
      const feeResult = document.getElementById(
        "fee-result"
      ) as HTMLElement | null;
      const calculatedFee = document.getElementById(
        "calculated-fee"
      ) as HTMLElement | null;
      const feeNote = document.getElementById("fee-note") as HTMLElement | null;

      function calculateFee() {
        if (
          !countrySelect ||
          !typeSelect ||
          !feeResult ||
          !calculatedFee ||
          !feeNote
        )
          return;

        const country = countrySelect.value;
        const type = typeSelect.value;

        if (!country || !type) {
          feeResult.classList.add("hidden");
          return;
        }

        let fee = "";
        let note = "";
        let feeAmount = 0;

        if (country === "LK") {
          switch (type) {
            case "early":
              fee = "LKR 3,500";
              feeAmount = 3500;
              note = "Early Bird Rate (Until September 5, 2025)";
              break;
            case "student":
              fee = "LKR 3,000";
              feeAmount = 3000;
              note = "Student Rate (Valid student ID required)";
              break;
            case "general":
              fee = "LKR 5,000";
              feeAmount = 5000;
              note = "General Registration Rate";
              break;
          }
        } else {
          switch (type) {
            case "early":
              fee = "USD 100";
              feeAmount = 100;
              note =
                "Early Bird Rate (Until September 5, 2025) ≈ LKR " +
                (100 * 305).toLocaleString();
              break;
            case "online":
              fee = "USD 50";
              feeAmount = 50;
              note =
                "Online Participation ≈ LKR " + (50 * 305).toLocaleString();
              break;
            case "general":
              fee = "USD 200";
              feeAmount = 200;
              note =
                "General Registration Rate ≈ LKR " +
                (200 * 305).toLocaleString();
              break;
            case "student":
              fee = "Not Available";
              note = "Student rates are only available for local participants";
              break;
          }
        }

        if (fee !== "Not Available") {
          calculatedFee.textContent = fee;
          feeNote.textContent = note + " (Bank service fees may apply)";
          feeResult.classList.remove("hidden");
        } else {
          feeResult.classList.add("hidden");
        }
      }

      if (countrySelect && typeSelect) {
        countrySelect.addEventListener("change", calculateFee);
        typeSelect.addEventListener("change", calculateFee);

        // Update type options based on country selection
        countrySelect.addEventListener("change", function () {
          const country = this.value;
          const typeOptions = typeSelect.options;

          // Clear current selection
          typeSelect.value = "";

          // Show/hide options based on country
          for (let i = 0; i < typeOptions.length; i++) {
            const option = typeOptions[i] as HTMLOptionElement;
            if (country === "LK") {
              // Local participants - show all except online
              option.style.display =
                option.value === "online" ? "none" : "block";
            } else if (country === "OTHER") {
              // Foreign participants - hide student option
              option.style.display =
                option.value === "student" ? "none" : "block";
            } else {
              // No country selected - show all
              option.style.display = "block";
            }
          }

          calculateFee();
        });
      }

      // Payment button click handler
      const paymentBtn = document.getElementById(
        "payment-btn"
      ) as HTMLButtonElement | null;
      if (paymentBtn) {
        paymentBtn.addEventListener("click", function () {
          // Here you would integrate with your actual payment gateway
          window.location.href = "http://localhost:4321/registration/payment";
        });
      }
    });
  </script>

  <style>
    /* Smooth transitions for all interactive elements */
    button,
    a,
    select {
      transition: all 0.2s ease-in-out;
    }

    /* Focus styles */
    select:focus {
      outline: none;
    }

    /* Step number animations */
    .step-number {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.7;
      }
    }
  </style>
</BaseLayout>
