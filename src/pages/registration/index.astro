</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Fee Calculator
    const countrySelect = document.getElementById("calc-country");
    const typeSelect = document.getElementById("calc-type");
    const feeResult = document.getElementById("fee-result");
    const calculatedFee = document.getElementById("calculated-fee");
    const feeNote = document.getElementById("fee-note");

    function calculateFee() {
      const country = countrySelect.value;
      const type = typeSelect.value;

      if (!country || !type) {
        feeResult.classList.add("hidden");
        return;
      }

      let fee = "";
      let note = "";
      let feeAmount = 0;

      if (country === "LK") {
        switch (type) {
          case "early":
            fee = "LKR 3,500";
            feeAmount = 3500;
            note = "Early Bird Rate (Until September 5, 2025)";
            break;
          case "student":
            fee = "LKR 3,000";
            feeAmount = 3000;
            note = "Student Rate (Valid student ID required)";
            break;
          case "general":
            fee = "LKR 5,000";
            feeAmount = 5000;
            note = "General Registration Rate";
            break;
        }
      } else {
        switch (type) {
          case "early":
            fee = "USD 100";
            feeAmount = 100;
            note =
              "Early Bird Rate (Until September 5, 2025) ≈ LKR " +
              (100 * 305).toLocaleString();
            break;
          case "online":
            fee = "USD 50";
            feeAmount = 50;
            note = "Online Participation ≈ LKR " + (50 * 305).toLocaleString();
            break;
          case "general":
            fee = "USD 200";
            feeAmount = 200;
            note =
              "General Registration Rate ≈ LKR " + (200 * 305).toLocaleString();
            break;
          case "student":
            fee = "Not Available";
            note = "Student rates are only available for local participants";
            break;
        }
      }

      if (fee !== "Not Available") {
        calculatedFee.textContent = fee;
        feeNote.textContent = note + " (Bank service fees may apply)";
        feeResult.classList.remove("hidden");
      } else {
        feeResult.classList.add("hidden");
      }
    }

    countrySelect.addEventListener("change", calculateFee);
    typeSelect.addEventListener("change", calculateFee);

    // Payment button click handler
    document
      .getElementById("payment-btn")
      .addEventListener("click", function () {
        // Here you would integrate with your actual payment gateway
        window.location.href = "http://localhost:4321/registration/payment";
      });

    // Update type options based on country selection
    countrySelect.addEventListener("change", function () {
      const country = this.value;
      const typeOptions = typeSelect.options;

      // Clear current selection
      typeSelect.value = "";

      // Show/hide options based on country
      for (let i = 0; i < typeOptions.length; i++) {
        const option = typeOptions[i];
        if (country === "LK") {
          // Local participants - show all except online
          option.style.display = option.value === "online" ? "none" : "block";
        } else if (country === "OTHER") {
          // Foreign participants - hide student option
          option.style.display = option.value === "student" ? "none" : "block";
        } else {
          // No country selected - show all
          option.style.display = "block";
        }
      }

      calculateFee();
    });
  });
</script>

<style>
  /* Smooth transitions for all interactive elements */
  button,
  a,
  select {
    transition: all 0.2s ease-in-out;
  }

  /* Focus styles */
  select:focus {
    outline: none;
  }

  /* Step number animations */
  .step-number {
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }
</style>
